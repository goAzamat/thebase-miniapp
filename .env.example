# ------------------------------------------------------------------
# Copy to .env.local for development. In production set these in the
# Vercel Dashboard → Project → Settings → Environment Variables.
# ------------------------------------------------------------------

# --- Odoo XML-RPC connection ---
ODOO_URL=https://odoo.thebasebev.com
ODOO_DB=qualityofdark-thebasebevodoo-production-30781491
# Service account used for all dashboard reads (needs read access to
# project.task, crm.lead, mrp.bom, mrp.bom.line, product.template,
# product.product, product.category).
ODOO_USERNAME=portal-service@thebasebev.com
ODOO_API_KEY=replace-with-odoo-api-key

# --- Auth.js (NextAuth v5) ---
# Generate with:  npx auth secret
AUTH_SECRET=replace-with-generated-secret
